# Normalize line endings: LF in the repository, native in the working copy.
* text=auto

# Keep these LF even on Windows checkouts.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.txt text eol=lf

# Binary assets.
*.png binary
*.graphml binary
